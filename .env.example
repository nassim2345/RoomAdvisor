# Copia questo file in .env.local e popola le chiavi.
# .env.local non va mai committato (è in .gitignore).

# Google AI Studio — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# SerpAPI — https://serpapi.com/manage-api-key
SERPAPI_KEY=

# Opzionale: modello Gemini (default gemini-2.5-flash)
# GEMINI_MODEL=

# Redis REST (Upstash o Vercel KV) per link condivisi e rate limit.
# Senza queste variabili si usa uno store in memoria: ok in locale,
# ma su Vercel i link condivisi smettono di funzionare tra istanze.
# Vercel KV imposta automaticamente KV_REST_API_URL / KV_REST_API_TOKEN.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Opzionale: URL pubblico del sito, per le immagini di anteprima dei link
# condivisi. Su Vercel viene ricavato automaticamente.
# NEXT_PUBLIC_SITE_URL=https://roomadvisor.example.com
