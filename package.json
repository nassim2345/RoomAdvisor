{
  "name": "roomadvisor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "desktop:prepare": "next build && node scripts/prepare-desktop.mjs",
    "desktop": "npm run desktop:prepare && electron .",
    "desktop:dist": "npm run desktop:prepare && electron-builder"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "next": "14.2.35",
    "react": "^18",
    "react-dom": "^18"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^2.1.9"
  },
  "description": "Upload room photos, get a style analysis and furniture you can buy.",
  "main": "electron/main.cjs",
  "author": "Nassim",
  "homepage": "https://github.com/nassim2345/RoomAdvisor",
  "repository": {
    "type": "git",
    "url": "https://github.com/nassim2345/RoomAdvisor.git"
  },
  "build": {
    "appId": "com.roomadvisor.app",
    "productName": "RoomAdvisor",
    "copyright": "© 2026 Nassim — MIT",
    "directories": {
      "output": "dist-desktop",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "build/icon.png",
      "package.json",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "server",
        "filter": [
          "**/*",
          ".next/**/*"
        ]
      }
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.lifestyle",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": null,
      "icon": "build/icon.png",
      "artifactName": "RoomAdvisor-${version}-${arch}-mac.${ext}"
    },
    "dmg": {
      "title": "RoomAdvisor",
      "artifactName": "RoomAdvisor-${version}-${arch}.${ext}",
      "backgroundColor": "#FAF7F2",
      "contents": [
        {
          "x": 150,
          "y": 190,
          "type": "file"
        },
        {
          "x": 390,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "RoomAdvisor",
      "artifactName": "RoomAdvisor-Setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Graphics",
      "maintainer": "Nassim",
      "synopsis": "Consigli d'arredo dalle foto della tua stanza",
      "icon": "build/icon.png"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "nassim2345",
        "repo": "RoomAdvisor",
        "releaseType": "release"
      }
    ],
    "appImage": {
      "artifactName": "RoomAdvisor-${version}.${ext}"
    },
    "deb": {
      "artifactName": "roomadvisor_${version}_${arch}.${ext}"
    }
  }
}
